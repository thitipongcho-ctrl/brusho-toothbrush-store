const SHEET_NAME = 'Orders';
const ADMIN_KEY = 'CHANGE_ME_TO_A_LONG_RANDOM_SECRET'; // เปลี่ยนค่านี้ก่อนเผยแพร่
function getSheet_(){const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(SHEET_NAME);if(!sh){sh=ss.insertSheet(SHEET_NAME);sh.appendRow(['orderId','createdAt','sku','product','qty','unitPrice','total','customer','phone','email','address','note','status']);}return sh;}
function doPost(e){try{const b=JSON.parse(e.postData.contents);if(b.action!=='create')throw Error('Invalid action');const o=b.order;if(!o||!o.orderId||!['BR-01','BR-02'].includes(o.sku)||!o.customer||!o.phone||!o.address)throw Error('ข้อมูลคำสั่งซื้อไม่ครบ');getSheet_().appendRow([o.orderId,o.createdAt,o.sku,o.product,Number(o.qty),Number(o.unitPrice),Number(o.total),o.customer,o.phone,o.email,o.address,o.note,o.status||'รอหยิบสินค้า']);return out_({ok:true,orderId:o.orderId});}catch(err){return out_({ok:false,error:String(err)});}}
function doGet(e){try{if(e.parameter.action!=='orders')throw Error('Invalid action');if(e.parameter.key!==ADMIN_KEY)throw Error('Unauthorized');const sh=getSheet_(),v=sh.getDataRange().getValues(),h=v.shift();const orders=v.filter(r=>r[0]).map(r=>Object.fromEntries(h.map((k,i)=>[k,r[i]])));return out_({ok:true,orders});}catch(err){return out_({ok:false,error:String(err)});}}
function out_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON);}
